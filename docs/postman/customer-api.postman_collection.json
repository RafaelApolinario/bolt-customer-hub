{
  "info": {
    "name": "Bolt Customer Hub API",
    "description": "Collection for local execution of the Customer Management API on port 8082. Run the happy path in order: Health, Create, List, Get by ID, Update, Latest, Delete. Error examples can also be executed individually.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "uniqueSuffix",
      "value": ""
    },
    {
      "key": "document",
      "value": ""
    },
    {
      "key": "consumerUnitNumber",
      "value": ""
    },
    {
      "key": "secondConsumerUnitNumber",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Health returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create customer",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString().slice(-9);",
              "pm.collectionVariables.set('uniqueSuffix', suffix);",
              "pm.collectionVariables.set('document', `99${suffix}`);",
              "pm.collectionVariables.set('consumerUnitNumber', `UC-${suffix}`);",
              "pm.collectionVariables.set('secondConsumerUnitNumber', `UC-${suffix}-2`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create returns 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('customerId', body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/customers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "customers"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Maria Silva\",\n  \"document\": \"{{document}}\",\n  \"consumerUnits\": [\n    {\n      \"number\": \"{{consumerUnitNumber}}\",\n      \"zipCode\": \"30140071\"\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "List customers",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/customers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "customers"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('List returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get customer by ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/customers/{{customerId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "customers",
            "{{customerId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Get by ID returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Update customer",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/customers/{{customerId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "customers",
            "{{customerId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Maria Silva Souza\",\n  \"document\": \"{{document}}\",\n  \"consumerUnits\": [\n    {\n      \"number\": \"{{consumerUnitNumber}}\",\n      \"zipCode\": \"30140071\"\n    },\n    {\n      \"number\": \"{{secondConsumerUnitNumber}}\",\n      \"zipCode\": \"30140071\"\n    }\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Update returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "List latest customers",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/customers/latest",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "customers",
            "latest"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Latest returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete customer",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/customers/{{customerId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "customers",
            "{{customerId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Delete returns 204', function () {",
              "  pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create customer with blocked state SP",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let suffix = pm.collectionVariables.get('uniqueSuffix');",
              "if (!suffix) {",
              "  suffix = Date.now().toString().slice(-9);",
              "  pm.collectionVariables.set('uniqueSuffix', suffix);",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Blocked state returns 422', function () {",
              "  pm.response.to.have.status(422);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/customers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "customers"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Cliente Bloqueado SP\",\n  \"document\": \"88{{uniqueSuffix}}\",\n  \"consumerUnits\": [\n    {\n      \"number\": \"UC-SP-{{uniqueSuffix}}\",\n      \"zipCode\": \"01001000\"\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "Create customer with duplicated document",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let suffix = pm.collectionVariables.get('uniqueSuffix');",
              "if (!suffix) {",
              "  suffix = Date.now().toString().slice(-9);",
              "  pm.collectionVariables.set('uniqueSuffix', suffix);",
              "}",
              "",
              "let document = pm.collectionVariables.get('document');",
              "if (!document) {",
              "  document = `77${suffix}`;",
              "  pm.collectionVariables.set('document', document);",
              "}",
              "",
              "const seedUnitNumber = `UC-DUP-SEED-${suffix}`;",
              "pm.sendRequest({",
              "  url: `${pm.collectionVariables.get('baseUrl')}/api/customers`,",
              "  method: 'POST',",
              "  header: { 'Content-Type': 'application/json' },",
              "  body: {",
              "    mode: 'raw',",
              "    raw: JSON.stringify({",
              "      name: 'Cliente Base Documento Duplicado',",
              "      document: document,",
              "      consumerUnits: [",
              "        { number: seedUnitNumber, zipCode: '30140071' }",
              "      ]",
              "    })",
              "  }",
              "}, function () {});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Duplicated document returns 409', function () {",
              "  pm.response.to.have.status(409);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/customers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "customers"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Documento Duplicado\",\n  \"document\": \"{{document}}\",\n  \"consumerUnits\": [\n    {\n      \"number\": \"UC-DUP-{{uniqueSuffix}}\",\n      \"zipCode\": \"30140071\"\n    }\n  ]\n}"
        }
      }
    }
  ]
}
